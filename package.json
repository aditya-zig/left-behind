{
  "name": "left-behind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "test:prep": "node tests/prep.mjs",
    "check": "npm run test && npm run build",
    "assets:verify": "node scripts/restore-assets.mjs --verify",
    "assets:restore": "node scripts/restore-assets.mjs --restore",
    "check:sources": "node --import tsx scripts/check-sources.ts"
  },
  "engines": {"node": ">=22.12.0"},
  "dependencies": {
    "@google/model-viewer": "4.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.172.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "5.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
